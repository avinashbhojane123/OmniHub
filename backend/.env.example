# Server Configuration
PORT=10000
GLOBAL_PREFIX=api
ALLOWED_ORIGINS=*

# Database Configuration (PostgreSQL Cloud or Local)
# For cloud databases (Neon, Supabase, Render, Railway):
DATABASE_URL=postgresql://user:password@cloud-db-host:5432/dbname?sslmode=require
DB_SSL=true
DB_SYNCHRONIZE=true

# Upload Configuration
UPLOAD_DIR=uploads
UPLOAD_PREFIX=/uploads/
MAX_FILE_SIZE_MB=100

# Instagram Preview Configuration (Without Official API)
# Paste your Instagram sessionid cookie value here:
# (Inspect Instagram in browser -> Application / Storage -> Cookies -> https://www.instagram.com -> sessionid)
INSTAGRAM_SESSION_ID=
