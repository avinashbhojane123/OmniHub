NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000

DATABASE_URL=postgresql://safeguard:safeguard_secret_password@localhost:5432/safeguard_db?schema=public

JWT_ACCESS_SECRET=safeguard_enterprise_access_secret_token_12345
JWT_REFRESH_SECRET=safeguard_enterprise_refresh_secret_token_67890
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

REDIS_HOST=localhost
REDIS_PORT=6379

FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key

CORS_ORIGIN=*

THROTTLE_TTL=60
THROTTLE_LIMIT=100
